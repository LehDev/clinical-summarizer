# ============================================================================
# .env.example - Template de variáveis de ambiente
#
# INSTRUÇÕES:
# 1. Copie este arquivo para .env: cp .env.example .env
# 2. Preencha os valores reais
# 3. NUNCA commite o arquivo .env no Git!
# ============================================================================

# ----------------------------------------------------------------------------
# PostgreSQL - Conexão com o banco de dados
# ----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=clinical_data
POSTGRES_USER=seu_usuario
POSTGRES_PASSWORD=sua_senha_secreta

# Configurações do pool de conexões
POSTGRES_POOL_MIN_SIZE=2
POSTGRES_POOL_MAX_SIZE=10

# ----------------------------------------------------------------------------
# Aplicação
# ----------------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# Google Gemini API (para fases futuras)
# ----------------------------------------------------------------------------
# GOOGLE_API_KEY=sua_api_key_aqui
